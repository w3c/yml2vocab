{
    "name": "yml2vocab",
    "version": "1.12.0",
    "description": "Generation of vocabulary files starting by YAML",
    "homepage": "https://github.com/w3c/yml2vocab",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/w3c/yml2vocab.git"
    },
    "bugs": {
        "url": "https://github.com/w3c/yml2vocab/issues"
    },
    "files": [
        "LICENSE.md",
        "README.md",
        "CHANGES.md",
        "dist/**/*"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "yml2vocab": "dist/main.js"
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "generate": "tsx main.ts",
        "docs": "mv docs/previews /tmp; typedoc index.ts main.ts lib/* ; mv /tmp/previews docs",
        "dist": "tsc",
        "distribute": "npm run dist && npm run docs",
        "local_vcdm": "tsx main.ts -v local/dev/vcdm/vocabulary.yml -t local/dev/vcdm//template.html -c",
        "local_test": "tsx main.ts -v local/tests/test.yml -t local/tests/test_template.html -c -y -m",
        "local_test_ident": "tsx main.ts -v local/tests/identification/vocabulary.yml -t local/tests/identification/template.html -c",
        "local_test_did": "tsx main.ts -v local/tests/did/vocabulary.yml -t local/tests/did/template.html -c",
        "local_test_epub": "tsx main.ts -v local/tests/epub/index.yml -t local/tests/epub/template.html -c",
        "local_test_lws": "tsx main.ts -v local/tests/lws/vocabulary.yml -t local/tests/lws/template.html -c",
        "local_test_mermaid": "tsx main.ts -v local/tests/mermaid/vocabulary.yml -t local/tests/mermaid/template.html -c -y -m"
    },
    "author": "Ivan Herman <ivan@w3.org> (https://www.w3.org/People/Ivan/)",
    "license": "W3C-20150513",
    "dependencies": {
        "@exodus/schemasafe": "^1.3.0",
        "@types/js-beautify": "^1.14.3",
        "commander": "^13.1.0",
        "editorconfig": "^3.0.1",
        "js-beautify": "^1.15.4",
        "jsdom": "^26.0.0",
        "yaml": "^2.7.0"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.19.19",
        "@typescript-eslint/eslint-plugin": "^8.21.0",
        "@typescript-eslint/parser": "^8.21.0",
        "eslint": "^9.19.0",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3"
    }
}
